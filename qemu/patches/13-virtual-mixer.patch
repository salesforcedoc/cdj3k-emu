+#define CDJ3K_MIXER_MAGIC 0x31584d43u /* "CMX1" little-endian */
+#define CDJ3K_MIXER_VERSION 1u
+#define CDJ3K_MIXER_CHANNELS 4u
+#define CDJ3K_MIXER_HEADER_BYTES 64u
+#define CDJ3K_MIXER_CHANNEL_BYTES 64u
+#define CDJ3K_MIXER_BYTES (CDJ3K_MIXER_HEADER_BYTES + \
+                           CDJ3K_MIXER_CHANNELS * CDJ3K_MIXER_CHANNEL_BYTES)
