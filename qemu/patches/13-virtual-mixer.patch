+typedef struct Cdj3kMixerChannel {
+    _Atomic uint32_t control[6]; /* trim, high, mid, low, filter, fader */
+    _Atomic uint32_t peak[2];
+    _Atomic uint32_t reserved[8];
+} Cdj3kMixerChannel;
