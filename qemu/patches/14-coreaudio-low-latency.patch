+/* Keep a device's existing virtual format whenever it already matches the
+ * interleaved float buffer produced by this backend. This matters for
+ * loopback/aggregate drivers, which often expose a valid fixed format but
+ * reject otherwise-redundant SetProperty calls. */
+static OSStatus coreaudio_negotiate_out_streamformat(
+    CoreaudioVoiceOut *core, AudioDeviceID device_id,
+    AudioStreamBasicDescription *active_format)
+{
+    AudioStreamBasicDescription current = { 0 };
+    OSStatus status = coreaudio_get_out_streamformat(device_id, &current);
+
+    if (status != kAudioHardwareNoError) {
+        coreaudio_playback_logerr(status,
+                                  "Could not get output stream format");
+        return status;
+    }
+    if (coreaudio_streamformat_is_compatible(&current,
+                                              core->hw.info.nchannels)) {
+        *active_format = current;
+        return kAudioHardwareNoError;
+    }
+
+    Float64 rate = current.mSampleRate;
+    if (rate <= 0) {
+        UInt32 size = sizeof(rate);
+
+        status = AudioObjectGetPropertyData(device_id, &device_rate_addr,
+                                            0, NULL, &size, &rate);
+        if (status != kAudioHardwareNoError || rate <= 0) {
+            if (status != kAudioHardwareNoError) {
+                coreaudio_playback_logerr(
+                    status, "Could not determine output stream rate");
+                return status;
+            }
+            error_report("coreaudio: output device reports no usable "
+                         "stream or nominal sample rate");
+            return kAudioHardwareIllegalOperationError;
+        }
+    }
+
+    AudioStreamBasicDescription requested = {
+        .mBitsPerChannel = sizeof(float) * 8,
+        .mBytesPerFrame = core->hw.info.nchannels * sizeof(float),
+        .mBytesPerPacket = core->hw.info.nchannels * sizeof(float),
+        .mChannelsPerFrame = core->hw.info.nchannels,
+        .mFormatFlags = kAudioFormatFlagsNativeFloatPacked,
+        .mFormatID = kAudioFormatLinearPCM,
+        .mFramesPerPacket = 1,
+        .mSampleRate = rate,
+    };
+    Boolean settable = false;
+
+    status = AudioObjectIsPropertySettable(device_id,
+                                           &out_stream_format_addr,
+                                           &settable);
+    if (status != kAudioHardwareNoError) {
+        coreaudio_playback_logerr(status,
+                                  "Could not query output stream format mutability");
+        return status;
+    }
+    if (!settable) {
+        error_report("coreaudio: output stream format is fixed and incompatible "
+                     "with %u-channel interleaved float32 playback "
+                     "(rate=%.0f channels=%u bits=%u flags=0x%x)",
+                     core->hw.info.nchannels, current.mSampleRate,
+                     (unsigned)current.mChannelsPerFrame,
+                     (unsigned)current.mBitsPerChannel,
+                     (unsigned)current.mFormatFlags);
+        return kAudioHardwareIllegalOperationError;
+    }
+
+    status = coreaudio_set_out_streamformat(device_id, &requested);
+    if (status != kAudioHardwareNoError) {
+        coreaudio_playback_logerr(status,
+                                  "Could not set compatible output stream format");
+        return status;
+    }
+
+    status = coreaudio_get_out_streamformat(device_id, &current);
+    if (status != kAudioHardwareNoError) {
+        coreaudio_playback_logerr(status,
+                                  "Could not verify output stream format");
+        return status;
+    }
+    if (!coreaudio_streamformat_is_compatible(&current,
+                                               core->hw.info.nchannels)) {
+        error_report("coreaudio: device did not accept a compatible "
+                     "%u-channel interleaved float32 stream format",
+                     core->hw.info.nchannels);
+        return kAudioHardwareIllegalOperationError;
+    }
+
+    *active_format = current;
+    return kAudioHardwareNoError;
+}
