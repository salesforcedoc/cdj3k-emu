+/* Recompute transcendental mixer coefficients only when a control or the
+ * live HAL stream rate changes. The per-buffer ramps below still run on every
+ * callback, preserving the existing click-free control response. */
+static void cdj3k_mixer_update_coefficients(CoreaudioVoiceOut *core,
+                                            Cdj3kMixerChannel *channel,
+                                            float sample_rate)
+{
+    uint32_t control[6];
+
+    for (size_t i = 0; i < ARRAY_SIZE(control); i++) {
+        control[i] = cdj3k_mixer_control(&channel->control[i]);
+    }
+    if (core->mixer_coefficients_valid
+        && core->mixer_coefficient_rate == sample_rate
+        && memcmp(control, core->mixer_control_cache,
+                  sizeof(control)) == 0) {
+        return;
+    }
+
+    float trim = cdj3k_mixer_norm(control[0]);
+    float high = cdj3k_mixer_norm(control[1]);
+    float mid = cdj3k_mixer_norm(control[2]);
+    float low = cdj3k_mixer_norm(control[3]);
+    float filter = cdj3k_mixer_norm(control[4]);
+    float fader = cdj3k_mixer_norm(control[5]);
+    float target_filter_alpha = core->mixer_filter_alpha;
+    int target_filter_mode = 0;
+
+    core->mixer_target_trim =
+        powf(10.0f, ((trim - 0.5f) * 24.0f) / 20.0f);
+    core->mixer_target_high = cdj3k_mixer_eq_gain(high);
+    core->mixer_target_mid = cdj3k_mixer_eq_gain(mid);
+    core->mixer_target_low = cdj3k_mixer_eq_gain(low);
+    core->mixer_target_fader = fader * fader * fader;
+
+    if (filter < 0.48f) {
+        float position = filter / 0.48f;
+        float cutoff = 80.0f * powf(18000.0f / 80.0f, position);
+        target_filter_alpha = cdj3k_mixer_alpha(cutoff, sample_rate);
+        target_filter_mode = -1; /* low-pass */
+    } else if (filter > 0.52f) {
+        float position = (filter - 0.52f) / 0.48f;
+        float cutoff = 20.0f * powf(10000.0f / 20.0f, position);
+        target_filter_alpha = cdj3k_mixer_alpha(cutoff, sample_rate);
+        target_filter_mode = 1; /* high-pass */
+    }
+
+    core->mixer_target_filter_alpha = target_filter_alpha;
+    core->mixer_target_filter_mode = target_filter_mode;
+    core->mixer_low_alpha = cdj3k_mixer_alpha(250.0f, sample_rate);
+    core->mixer_high_alpha = cdj3k_mixer_alpha(4000.0f, sample_rate);
+    memcpy(core->mixer_control_cache, control, sizeof(control));
+    core->mixer_coefficient_rate = sample_rate;
+    core->mixer_coefficients_valid = true;
+}
