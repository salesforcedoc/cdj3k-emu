 }
 
+void audio_register_reset_handler(audio_reset_handler_fn handler, void *opaque)
+{
+    assert(handler != NULL);
+    assert(audio_reset_handler == NULL ||
+           (audio_reset_handler == handler && audio_reset_opaque == opaque));
+    audio_reset_handler = handler;
+    audio_reset_opaque = opaque;
+}
+
+void audio_unregister_reset_handler(audio_reset_handler_fn handler, void *opaque)
+{
+    if (audio_reset_handler == handler && audio_reset_opaque == opaque) {
+        audio_reset_handler = NULL;
+        audio_reset_opaque = NULL;
+    }
+}
