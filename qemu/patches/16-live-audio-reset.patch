     }
     return ret;
 }
+
+void qmp_x_cdj3k_audio_reset(Error **errp)
+{
+    if (!audio_reset_handler) {
+        error_setg(errp, "No live virtio-sound output is available to reset");
+        return;
+    }
+    audio_reset_handler(audio_reset_opaque, errp);
+}
diff --git a/hw/audio/virtio-snd.c b/hw/audio/virtio-snd.c
index 8912c68..7f31917 100644
--- a/hw/audio/virtio-snd.c
+++ b/hw/audio/virtio-snd.c
@@ -37,6 +37,7 @@ static void virtio_snd_pcm_flush(VirtIOSoundPCMStream *stream);
 static void virtio_snd_pcm_in_cb(void *data, int available);
 static void virtio_snd_unrealize(DeviceState *dev);
 static void virtio_snd_pcm_buffer_free(VirtIOSoundPCMBuffer *buffer);
+static const char *print_code(uint32_t code);
 
 /* ============= CoreAudio bypass ring (Darwin only) =============
  * SPSC ring: virtio-snd writes (main loop), CoreAudio IOProc reads (RT).
@@ -1606,6 +1607,58 @@ static uint32_t virtio_snd_pcm_prepare(VirtIOSound *s, uint32_t stream_id)
     return cpu_to_le32(VIRTIO_SND_S_OK);
 }
 
+/* Recreate the host voice without resetting the virtio device or guest. The
+ * guest-visible stream object, negotiated parameters and START/STOP state stay
+ * intact. Closing first also stops the bypass writer and flushes outstanding
+ * completions before CoreAudio is reopened. */
+static void virtio_snd_audio_reset(void *opaque, Error **errp)
+{
+    VirtIOSound *s = opaque;
+    bool found_output = false;
+
+    for (uint32_t i = 0; i < s->snd_conf.streams; i++) {
+        VirtIOSoundPCMStream *stream = s->pcm.streams[i];
+        bool was_active;
+        uint32_t status;
+
+        if (!stream || stream->info.direction != VIRTIO_SND_D_OUTPUT) {
+            continue;
+        }
+        found_output = true;
+        WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+            was_active = stream->active;
+        }
+
+        virtio_snd_pcm_close(stream);
+        status = virtio_snd_pcm_prepare(s, i);
+        if (status != cpu_to_le32(VIRTIO_SND_S_OK)) {
+            /* Keep the guest lifecycle state for a later retry. With no host
+             * voice, audio_be_write safely returns zero and leaves queued TX
+             * buffers intact instead of advancing or dropping them. */
+            WITH_QEMU_LOCK_GUARD(&stream->queue_mutex) {
+                stream->active = was_active;
+            }
+            error_setg(errp,
+                       "Could not reopen virtio-sound stream %"PRIu32
+                       " (status 0x%08"PRIx32")",
+                       i, le32_to_cpu(status));
+            return;
+        }
+
+        /* pcm_prepare intentionally does not alter the guest lifecycle state.
+         * Reapply it to the new software voice so a playing deck resumes as
+         * soon as CoreAudio starts, while a stopped deck remains stopped. */
+        audio_be_set_active_out(s->audio_be, stream->voice.out, was_active);
+        if (was_active) {
+            vsnd_writer_wake();
+        }
+    }
+
+    if (!found_output) {
+        error_setg(errp, "No virtio-sound output stream is available to reset");
+    }
+}
+
 static const char *print_code(uint32_t code)
 {
     #define CASE(CODE)            \
@@ -2259,6 +2312,8 @@ static void virtio_snd_realize(DeviceState *dev, Error **errp)
         }
     }
 
+    audio_register_reset_handler(virtio_snd_audio_reset, vsnd);
+
     return;
 
 error_cleanup:
@@ -2517,6 +2572,7 @@ static void virtio_snd_unrealize(DeviceState *dev)
     VirtIOSound *vsnd = VIRTIO_SND(dev);
     VirtIOSoundPCMStream *stream;
 
+    audio_unregister_reset_handler(virtio_snd_audio_reset, vsnd);
     qemu_del_vm_change_state_handler(vsnd->vmstate);
     trace_virtio_snd_unrealize(vsnd);
 
