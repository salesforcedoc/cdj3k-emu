+
+/* Encode a true peak into the UI's -60 dB .. +12 dB meter range. Keeping
+ * this pre-clipping lets the red +12 dB segment report overloads that the
+ * output safety clamp would otherwise hide. */
+static uint32_t cdj3k_mixer_peak_raw(float linear)
+{
+    if (linear <= 0.001f) {
+        return 0;
+    }
+    float db = 20.0f * log10f(linear);
+    float normalized = (MAX(-60.0f, MIN(12.0f, db)) + 60.0f) / 72.0f;
+    return (uint32_t)(normalized * 1000.0f);
 }
 
